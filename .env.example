# SYGOS — runtime (Coolify / local)
NODE_ENV=production
PORT=3000

# PostgreSQL (Coolify crea DATABASE_URL al vincular la DB)
DATABASE_URL=postgresql://user:pass@host:5432/sygos-db

# Solo primer arranque / seed (secret en Coolify, nunca en git)
SYGOS_VECTORIA_INITIAL_PASSWORD=
SYGOS_AUTO_SEED=0

# Usuarios demo por rol (staging); npm run db:seed-demo o seed completo
SYGOS_DEMO_USERS_PASSWORD=
